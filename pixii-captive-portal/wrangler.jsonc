{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "9423b9bb3bc960f803d00c7718b78cad",
  "name": "pixii-event-wifi",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false, "persist": true },
    "traces": { "enabled": false }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "wifi.joinpixii.com", "custom_domain": true }
  ],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "pixii-event-wifi-production",
    "database_id": "7355bd32-98f0-41c9-9781-24c9c38e410f"
  }],
  "triggers": { "crons": ["17 9 * * *", "*/5 * * * *"] },
  "ratelimits": [{ "name": "ANALYTICS_LIMIT", "namespace_id": "2026093001", "simple": { "limit": 600, "period": 60 } }],
  "vars": {
    "ENVIRONMENT": "production",
    "ANALYTICS_ENABLED": "false",
    "ANALYTICS_ROLLOUT_AT": "",
    "PRIVACY_US_REVIEWED": "false",
    "PIXELS_ENABLED": "false",
    "META_ENABLED": "false",
    "GOOGLE_ENABLED": "false",
    "LINKEDIN_ENABLED": "false",
    "LINKEDIN_PARTNER_ID": "",
    "RB2B_ENABLED": "false",
    "RB2B_DOMAIN_VERIFIED": "false"
  },
  "rules": [
    { "type": "Text", "globs": ["**/*.svg"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.webp"], "fallthrough": true }
  ]
}
